{
  "name": "@cesarus777/opencode-cgp",
  "version": "0.2.3",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./rpc": {
      "types": "./dist/types/rpc.d.ts",
      "import": "./dist/rpc.js",
      "default": "./dist/rpc.js"
    },
    "./tui": {
      "types": "./dist/types/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    },
    "./server": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "inspect": "bun src/cli.ts",
    "test:live": "bun scripts/live.ts",
    "format": "prettier --write src tests scripts docs README.md examples package.json tsconfig.json server.ts tui.tsx rpc.ts tsconfig.build.json .github AGENTS.md",
    "format:check": "prettier --check src tests scripts docs README.md examples package.json tsconfig.json server.ts tui.tsx rpc.ts tsconfig.build.json .github AGENTS.md",
    "test:tui-live": "bun scripts/tui-live.ts",
    "bench:tui": "bun scripts/tui-bench.ts",
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "prepare": "bun run build",
    "test:package": "bun scripts/package-smoke.ts",
    "validate": "bun run format:check && bun run typecheck && bun test && bun run test:package",
    "test:metrics-live": "bun scripts/metrics-live.ts",
    "charts": "bun src/cli.ts charts",
    "test:metrics-server-live": "bun scripts/metrics-server-live.ts"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.29",
    "@opencode/client": "2.0.29"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "typescript": "5.9.3",
    "prettier": "3.6.2",
    "solid-js": "1.9.15",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@opencode/theme": "2.0.29"
  },
  "engines": {
    "bun": ">=1.1.34"
  },
  "peerDependencies": {
    "solid-js": ">=1.9.0",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    }
  },
  "description": "Early native compaction policy and context monitoring for OpenCode V2 root and nested-agent sessions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cesarus777/opencode-cgp.git"
  },
  "homepage": "https://github.com/cesarus777/opencode-cgp#readme",
  "bugs": {
    "url": "https://github.com/cesarus777/opencode-cgp/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "context",
    "compaction",
    "tokens"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "context-guard": "./dist/cli.js"
  }
}
