{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "paths": {
      "@cesarus777/opencode-cgp": ["./src/index.ts"],
      "@cesarus777/opencode-cgp/server": ["./src/index.ts"],
      "@cesarus777/opencode-cgp/*": ["./src/*"]
    }
  },
  "include": ["src", "tests", "scripts", "server.ts", "tui.tsx", "rpc.ts"]
}
